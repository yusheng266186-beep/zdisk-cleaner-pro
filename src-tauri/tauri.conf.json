{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZDiskCleanerPro",
  "version": "3.0.6",
  "identifier": "com.zdiskcleaner.pro",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ZDiskCleaner Pro",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0M0MxQkMyQkMwMUMzNEIKUldSTHd3Rzh3aHM4eEhkYTcwb2Q2OFBXUVdtSGlsL0kyUkUwQU53QnBvYlJDTWV3aXlvekxPV3AK",
      "endpoints": [
        "https://github.com/yusheng266186-beep/zdisk-cleaner-pro/releases/latest/download/latest.json"
      ]
    }
  }
}